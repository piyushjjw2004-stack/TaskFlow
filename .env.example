# TaskFlow local development environment template.
# Copy to .env and replace the example credentials before use.

ENVIRONMENT=development

POSTGRES_USER=taskflow
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=taskflow_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# If the password contains URL-reserved characters, URL-encode it in DATABASE_URL.
DATABASE_URL=postgresql://taskflow:replace-with-a-local-development-password@postgres:5432/taskflow_db

# Generate a random value with at least 32 characters for real use.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

FRONTEND_PORT=3000
VITE_API_URL=/api

GRAFANA_ADMIN_PASSWORD=replace-with-a-local-grafana-password
