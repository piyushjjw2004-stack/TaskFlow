# TaskFlow Backend Local Development Environment
# Copy this file to .env for local debugging: cp .env.example .env

ENVIRONMENT=development
DATABASE_URL=sqlite:///./taskflow_local.db
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars-long
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
